# Redash Instance URL (required)
REDASH_URL=https://your-redash-instance.com

# OIDC device authorization (required)
REDASH_OIDC_ISSUER=https://auth.example.com/application/o/redash-api/
REDASH_OIDC_CLIENT_ID=redash-api

# Optional: defaults to REDASH_OIDC_CLIENT_ID
REDASH_OIDC_AUDIENCE=redash-api

# Optional: defaults to "openid email offline_access"
REDASH_OIDC_SCOPES=openid email offline_access

# Optional: Timeout for API requests in milliseconds
REDASH_TIMEOUT=30000

# Optional: Maximum number of results to return
REDASH_MAX_RESULTS=1000

# Optional: Extra HTTP headers (JSON or key=value;key2=value2)
# Example for Cloudflare Access:
# REDASH_EXTRA_HEADERS='{"CF-Access-Client-Id":"your_client_id","CF-Access-Client-Secret":"your_client_secret"}'

# Optional: Streamable HTTP transport (stdio is the default)
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_BODY_LIMIT=1mb

# Required when MCP_HTTP_HOST is not loopback; comma-separated hostnames without ports
# MCP_HTTP_ALLOWED_HOSTS=mcp.example.com

# Optional: exact browser Origin allowlist; requests without Origin are allowed
# MCP_HTTP_ALLOWED_ORIGINS=https://mcp-client.example.com
